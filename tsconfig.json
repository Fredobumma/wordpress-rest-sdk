{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src", "test", "scripts", "vitest.config.ts"]
}
